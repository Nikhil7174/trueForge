# TrueForge server (local npx default)
TRUEFORGE_BASE_URL=http://localhost:8790

# Required only when TrueForge OIDC login is enabled
# TRUEFORGE_TOKEN=

# Model FQN already configured in TrueForge Settings → Models
# Format: <provider name>/<model name as listed in TrueForge>, e.g. openai/gpt-5-5
TRUEFORGE_MODEL=openai/gpt-5-5

# TrueForge blocks MCP URLs on private/loopback hosts. Start TrueForge itself with:
#   OUTBOUND_URL_ALLOWED_HOSTS='["127.0.0.1","localhost"]' npx @truefoundry/trueforge
# (exact-host allow-list; everything else stays protected)

# Public URL TrueForge uses to reach this MCP (same machine = localhost)
ACCESS_REVIEWER_MCP_URL=http://127.0.0.1:8765/mcp
ACCESS_REVIEWER_MCP_PORT=8765

# Skills are git-backed. Push this repo, then set the HTTPS URL so seed can
# register skills/access-review-playbook, skills/blast-radius and skills/migration-rehearsal.
# SKILL_GIT_URL=https://github.com/your-org/trueforge-hackathon.git
# SKILL_GIT_REF=main

# MCP policy: never revoke these principal name prefixes
DENY_PRINCIPAL_PREFIXES=Admin,BreakGlass,OrganizationAccountAccessRole

# Unused-access window in days
UNUSED_AFTER_DAYS=90

# ---- AWS (cost-janitor, infra/ scripts) ----
# Credentials come from the standard boto3 chain (~/.aws/credentials, AWS_PROFILE, or env keys).
AWS_REGION=us-west-2
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- cost-janitor MCP ----
COST_JANITOR_MCP_URL=http://127.0.0.1:8766/mcp
COST_JANITOR_MCP_PORT=8766
COST_JANITOR_REGION=us-west-2
# Resource Name prefixes the MCP refuses to mutate (tags env=prod/production, keep=true, do-not-delete always protected)
DENY_RESOURCE_PREFIXES=prod-,production-

# ---- migration-rehearsal (db-gate) ----
# Two least-privilege roles created by `tf-gate-seed-demo`:
READER_URL=postgresql://gate_reader:READER_PW@HOST/appdb?sslmode=require
MIGRATOR_URL=postgresql://gate_migrator:MIGRATOR_PW@HOST/appdb?sslmode=require
# Role that owns the tables; apply_migration runs `SET LOCAL ROLE` to it so new objects get the same owner.
MIGRATION_ROLE=app_owner

# Bearer token TrueForge sends to the gate (tf-seed registers it on the db-gate connector):  openssl rand -hex 24
GATE_TOKEN=
GATE_HOST=127.0.0.1
GATE_PORT=8811
# URL TrueForge uses to reach the gate. Defaults to http://localhost:<GATE_PORT>/mcp.
# TrueForge in Docker: http://host.docker.internal:8811/mcp (and GATE_HOST=0.0.0.0)
# GATE_PUBLIC_URL=
