# TrueForge server (local npx default)
TRUEFORGE_BASE_URL=http://localhost:8790

# Required only when TrueForge OIDC login is enabled
# TRUEFORGE_TOKEN=

# Model FQN already configured in TrueForge Settings → Models
# Format: <provider name>/<model name as listed in TrueForge>, e.g. openai/gpt-5-5
TRUEFORGE_MODEL=openai/gpt-5-5

# TrueForge blocks MCP URLs on private/loopback hosts. Start TrueForge itself with:
#   OUTBOUND_URL_ALLOWED_HOSTS='["127.0.0.1","localhost"]' npx @truefoundry/trueforge
# (exact-host allow-list; everything else stays protected)

# Public URL TrueForge uses to reach this MCP (same machine = localhost)
ACCESS_REVIEWER_MCP_URL=http://localhost:8765/mcp
ACCESS_REVIEWER_MCP_PORT=8765

# Skills are git-backed. Push this repo, then set the HTTPS URL so seed can
# register skills/access-review-playbook, skills/blast-radius and skills/migration-rehearsal.
# SKILL_GIT_URL=https://github.com/your-org/trueforge-hackathon.git
# SKILL_GIT_REF=main

# IAM backend for the access-reviewer MCP: fixture (in-memory, default) | aws (live IAM + CloudTrail)
IAM_BACKEND=aws
# (advisor = Access Advisor implementation in aws_iam.py, original four tools only)
# Regions searched for role CloudTrail events (IAM/STS calls land in us-east-1 or the caller's region)
# IAM_CLOUDTRAIL_REGIONS=us-west-2,us-east-1

# MCP policy: never revoke these principal name prefixes
DENY_PRINCIPAL_PREFIXES=Admin,BreakGlass,OrganizationAccountAccessRole

# Unused-access window in days
UNUSED_AFTER_DAYS=90

# ---- AWS (cost-janitor, infra/ scripts) ----
# Credentials come from the standard boto3 chain (~/.aws/credentials, AWS_PROFILE, or env keys).
AWS_REGION=us-west-2
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- cost-janitor MCP ----
COST_JANITOR_MCP_URL=http://127.0.0.1:8766/mcp
COST_JANITOR_MCP_PORT=8766
COST_JANITOR_REGION=us-west-2
# Resource Name prefixes the MCP refuses to mutate (tags env=prod/production, keep=true, do-not-delete always protected)
DENY_RESOURCE_PREFIXES=prod-,production-

# ---- Umbrella agent (one agent merging the member plugins) ----
UMBRELLA_AGENT_NAME=platform-guardian
# Drop a member to run without its gate (db-gate, ship-gate, ticket-gate)
UMBRELLA_MEMBERS=cost-janitor,access-reviewer,migration-rehearsal,release-captain,ticket-resolver

# ---- GitHub audit trail (optional) (TrueForge catalog GitHub MCP) ----
# Fine-grained PAT with Issues: read/write on AUDIT_REPO only. Stored on the TrueForge connector by tf-seed.
GITHUB_PAT=
AUDIT_REPO=owner/repo

# ---- access-reviewer (IAM_BACKEND=advisor only) ----
# Optional: only list these IAM names. Revoke still uses DEMO_REVOKE_PRINCIPAL.
# ACCESS_REVIEWER_ONLY_PRINCIPALS=NikhilZynix
# DEMO_REVOKE_PRINCIPAL=NikhilZynix

# ---- migration-rehearsal (db-gate) ----
# Two least-privilege roles created by `tf-gate-seed-demo`:
READER_URL=postgresql://gate_reader:READER_PW@HOST/appdb?sslmode=require
MIGRATOR_URL=postgresql://gate_migrator:MIGRATOR_PW@HOST/appdb?sslmode=require
# Role that owns the tables; apply_migration runs `SET LOCAL ROLE` to it so new objects get the same owner.
MIGRATION_ROLE=app_owner

# Bearer token TrueForge sends to the gate (tf-seed registers it on the db-gate connector):  openssl rand -hex 24
GATE_TOKEN=
GATE_HOST=127.0.0.1
GATE_PORT=8811
# URL TrueForge uses to reach the gate. Defaults to http://localhost:<GATE_PORT>/mcp.
# TrueForge in Docker: http://host.docker.internal:8811/mcp (and GATE_HOST=0.0.0.0)
# GATE_PUBLIC_URL=

# --- release-captain (ship-gate) ------------------------------------------------------------
# The repository the captain cuts releases for, as owner/name. Must be public: verify_build.py
# clones it from the sandbox without a token.
GITHUB_REPO=your-org/your-repo
# Fine-grained PAT on that repo with Contents: read and write (tags + releases). ship-gate is the
# only holder; the sandbox never sees it.
GITHUB_TOKEN=
# ship-gate reuses GATE_TOKEN as its bearer token and GATE_STATE_DIR as its ledger, so it can read
# db-gate's record of which migrations are actually applied.
SHIP_HOST=127.0.0.1
SHIP_PORT=8812
# URL TrueForge uses to reach ship-gate. Defaults to http://localhost:<SHIP_PORT>/mcp.
# SHIP_PUBLIC_URL=
SHIP_MAX_VERIFICATION_AGE_HOURS=24
# Comma-separated path fragments that mark a .sql file as a migration in release_scope.
SHIP_MIGRATION_PATHS=migrations/,demo/migrations/
# Set to false ONLY to demonstrate what the gate is protecting against.
SHIP_REQUIRE_MIGRATIONS_APPLIED=true

# ---- ticket-resolver (ticket-gate + trigger) ----
# Personal API key with write access; only ticket-gate and the trigger use it (Linear → Settings → API)
LINEAR_API_KEY=
LINEAR_TEAM_KEY=ZYN
LINEAR_TRIGGER_LABEL=Bug
# Label → job routing for the single trigger (make linear). All jobs run on the platform-guardian agent.
# LINEAR_ROUTES=Bug=ticket-resolver,cloudcost=cost-janitor,iam-review=access-reviewer,migration=migration-rehearsal,release=release-captain
# Bearer token TrueForge sends to ticket-gate:  openssl rand -hex 24
TICKET_GATE_TOKEN=
TICKET_GATE_HOST=127.0.0.1
TICKET_GATE_PORT=8821
# Product code the agent reproduces against (default: the bundled aco-api demo)
# TICKET_REPO_PATH=
# TICKET_TEST_COMMAND=python3 -m unittest discover -s tests
# ticket-gate reads db-gate's ledger (GATE_STATE_DIR, default ./.gate) to see the verdict for a migration
# handed off by the ticket-resolver, so run both gates from the repo root or set GATE_STATE_DIR for both.
# Handoff worker (runs inside tf-ticket-trigger, or alone with `tf-ticket-trigger handoffs`):
# HANDOFF_POLL_SECONDS=5
# HANDOFF_IDLE_TIMEOUT_SECONDS=900
